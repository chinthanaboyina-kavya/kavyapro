{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Registered user profile details synced from Firebase Auth",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth user ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 255
        },
        "displayName": {
          "type": "string",
          "description": "User full name or display handle",
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "URL or avatar identifier",
          "maxLength": 500
        },
        "bio": {
          "type": "string",
          "description": "Short bio or tagline",
          "maxLength": 300
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Whether the user email is verified"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the profile was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the profile was last modified"
        }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores individual user profile and settings"
    }
  }
}
